@model MyQabayel.Admin.Services.EngagementIndexModel
@{
    ViewData["Title"] = "Customer engagement";
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <div class="text-uppercase text-muted small fw-bold">Flyers · Offers · Notifications</div>
        <h1 class="h3 mb-1">Customer engagement</h1>
        <p class="text-muted mb-0">Monitor reactions and comments from customers in this loyalty group.</p>
    </div>
</div>

<form asp-action="Index" method="get" class="card card-body mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-3">
            <label class="form-label" for="type">Content type</label>
            <select class="form-select" id="type" name="type">
                <option value="">All</option>
                <option value="Flyer" selected="@(Model.ContentType == "Flyer")">Flyers</option>
                <option value="Offer" selected="@(Model.ContentType == "Offer")">Special offers</option>
                <option value="Notification" selected="@(Model.ContentType == "Notification")">Notifications</option>
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label" for="search">Title or item ID</label>
            <input class="form-control" id="search" name="search" value="@Model.Search" maxlength="100" />
        </div>
        <div class="col-md-3">
            <label class="form-label" for="customerId">Customer ID</label>
            <input class="form-control" id="customerId" name="customerId" type="number" min="1" value="@Model.CustomerId" />
        </div>
        <div class="col-md-2"><button type="submit" class="btn btn-centro w-100">Filter</button></div>
    </div>
</form>

<div class="card overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Content</th><th>Status</th><th>Reactions</th><th>Visible comments</th><th>Updated (UTC)</th><th></th></tr></thead>
            <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td><strong>@item.Title</strong><div class="small text-muted">@item.ContentType #@item.Id</div></td>
                    <td>@item.Status</td>
                    <td>@item.Reactions</td>
                    <td>@item.Comments</td>
                    <td>@item.UpdatedAtUtc.ToString("dd MMM yyyy HH:mm")</td>
                    <td><a class="btn btn-outline-secondary btn-sm" asp-action="Details" asp-route-type="@item.ContentType" asp-route-id="@item.Id">View activity</a></td>
                </tr>
            }
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-muted py-5">No matching content in this loyalty group.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
<div class="d-flex gap-2 mt-3">
    @if (Model.Page > 1)
    {
        <a class="btn btn-outline-secondary btn-sm" asp-action="Index" asp-route-type="@Model.ContentType" asp-route-search="@Model.Search" asp-route-customerId="@Model.CustomerId" asp-route-page="@(Model.Page - 1)">Previous</a>
    }
    @if (Model.HasMore)
    {
        <a class="btn btn-outline-secondary btn-sm" asp-action="Index" asp-route-type="@Model.ContentType" asp-route-search="@Model.Search" asp-route-customerId="@Model.CustomerId" asp-route-page="@(Model.Page + 1)">Next</a>
    }
</div>

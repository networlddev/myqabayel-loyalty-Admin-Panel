@model Campaign
@{ ViewData["Title"] = "Delete Campaign"; }
<div class="form-card"><span class="eyebrow">CONFIRM DELETE</span><h1>Delete campaign?</h1><p>You are deleting <b>@Model.Title</b> and its @Model.Images.Count Admin DB image record(s).</p>@if(Model.ErpRecordId is not null){<div class="alert alert-warning">This campaign was published as ERP ID #@Model.ErpRecordId. Deleting here will not remove the existing ERP record.</div>}<p class="text-muted">Physical upload files are retained to avoid breaking published image URLs.</p><form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex justify-content-end gap-2"><a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">Cancel</a><button class="btn btn-danger" type="submit">Delete permanently</button></form></div>

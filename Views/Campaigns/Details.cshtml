@model Campaign
@{ ViewData["Title"] = "Campaign Details"; }
<div class="d-flex justify-content-between align-items-start mb-4"><div><span class="eyebrow">@Model.CampaignType</span><h1>@Model.Title</h1><p class="text-muted mb-0">Admin ID #@Model.Id · @Model.Status · @Model.PublishStatus</p></div><div class="d-flex gap-2"><form asp-action="Publish" asp-route-id="@Model.Id" method="post"><button class="btn btn-success" type="submit">@(Model.Status == "Draft" ? "Publish" : "Publish Again")</button></form>@if (Model.CampaignType is "Flyer" or "Offer") { <a class="btn btn-outline-secondary" asp-controller="Engagement" asp-action="Details" asp-route-type="@Model.CampaignType" asp-route-id="@Model.Id">Customer reactions &amp; comments</a> }<a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a><a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.Id">Delete</a></div></div>
<div class="panel p-4 mb-4"><div class="row g-4"><div class="col-md-6"><b>Header</b><p>@(Model.Header ?? "—")</p><b>Description</b><p>@(Model.Body ?? "—")</p><b>Audience</b><p>@(Model.AudienceCondition == 1 ? "All customers" : Model.AudienceCondition == 2 ? "Points customers" : $"Recent customers ({Model.RecentDays} days)")</p></div><div class="col-md-6"><b>Schedule</b><p>@Model.StartDateUtc.ToString("dd MMM yyyy") to @Model.EndDateUtc.ToString("dd MMM yyyy")</p><b>ERP branch</b><p>@(Model.ErpBranchId?.ToString() ?? "All branches")</p>@if(Model.CampaignType == "Advertisement"){<b>Playback</b><p>@Model.DisplaySeconds seconds · Skip @(Model.AllowSkip ? "enabled" : "disabled")</p>}</div></div></div>
<h2 class="h5 mb-3">Images (@Model.Images.Count)</h2><div class="campaign-gallery mb-4">@foreach(var image in Model.Images.OrderBy(x => x.SortOrder)){<a href="@image.ImageUrl" target="_blank" rel="noopener"><img src="@image.ImageUrl" alt="@Model.Title image"/></a>}</div><a class="btn btn-outline-secondary" asp-action="Index" asp-route-type="@Model.CampaignType">Back</a>


@model CampaignEditViewModel
@{ ViewData["Title"] = "Edit Campaign"; }
<div class="form-card"><span class="eyebrow">EDIT @Model.CampaignType.ToUpperInvariant()</span><h1>Edit campaign</h1>
<form asp-action="Edit" method="post" enctype="multipart/form-data" class="row g-3 mt-2"><input asp-for="Id" type="hidden"/><input asp-for="CampaignType" type="hidden"/><div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="col-12"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control"/><span asp-validation-for="Title" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="AudienceCondition" class="form-label">Audience</label><select asp-for="AudienceCondition" class="form-select"><option value="1">All customers</option><option value="2">Points customers</option><option value="3">Recent customers</option></select></div>
<div class="col-md-6"><label asp-for="RecentDays" class="form-label">Recent customer window (days)</label><input asp-for="RecentDays" class="form-control" min="1" max="365"/><span asp-validation-for="RecentDays" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="ErpBranchId" class="form-label">ERP branch ID (optional)</label><input asp-for="ErpBranchId" class="form-control" min="1"/></div><div class="col-md-6"><label asp-for="StartDate" class="form-label"></label><input asp-for="StartDate" class="form-control"/></div><div class="col-md-6"><label asp-for="EndDate" class="form-label"></label><input asp-for="EndDate" class="form-control"/><span asp-validation-for="EndDate" class="text-danger"></span></div>
@if(Model.CampaignType == "Advertisement"){<div class="col-md-6"><label asp-for="DisplaySeconds" class="form-label">Display duration (seconds)</label><input asp-for="DisplaySeconds" class="form-control" min="1" max="300"/></div><div class="col-md-6 d-flex align-items-center pt-4"><div class="form-check"><input asp-for="AllowSkip" class="form-check-input"/><label asp-for="AllowSkip" class="form-check-label">Allow skip</label></div></div>}
<div class="col-12"><label asp-for="Header" class="form-label"></label><input asp-for="Header" class="form-control"/></div><div class="col-12"><label asp-for="Body" class="form-label">Description</label><textarea asp-for="Body" class="form-control" rows="4"></textarea></div>
<div class="col-12"><label asp-for="NewImages" class="form-label">Add more images (optional)</label><input asp-for="NewImages" class="form-control" accept="image/png,image/jpeg,image/webp" multiple/><span asp-validation-for="NewImages" class="text-danger"></span><div class="form-text">Current: @Model.ExistingImages.Count image(s). Maximum 10 images total.</div></div><div class="campaign-gallery compact">@foreach(var image in Model.ExistingImages){<img src="@image.ImageUrl" alt="Existing campaign image"/>}</div>
<div class="col-12 d-flex justify-content-end gap-2"><a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">Cancel</a><button class="btn btn-outline-primary" type="submit" name="publishAfterSave" value="false">Save changes</button><button class="btn btn-success" type="submit" name="publishAfterSave" value="true">Save &amp; publish to app</button></div></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial"/> }

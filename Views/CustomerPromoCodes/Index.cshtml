@model IReadOnlyList<PromoMasterSummary>
@{ ViewData["Title"] = "Customer PromoCodes"; }

<div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-4">
    <div>
        <span class="eyebrow">LOYALTY DISCOUNTS</span>
        <h1>Customer PromoCodes</h1>
        <p class="text-muted mb-0">Create department-specific discount campaigns and issue individual customer barcodes for @ViewData["GroupCode"].</p>
    </div>
    <a class="btn btn-centro" asp-action="Create">+ New promo master</a>
</div>
@if (ViewData["CreateDrafts"] is IReadOnlyList<PromoCreateDraftSummary> createDrafts && createDrafts.Count > 0)
{
    <div class="panel p-3 mb-4"><h2 class="h5">Saved campaign drafts</h2>
        @foreach (var draft in createDrafts)
        {
            <div class="d-flex justify-content-between align-items-center border-top py-2"><div><strong>@(string.IsNullOrWhiteSpace(draft.Name) ? "Untitled draft" : draft.Name)</strong><div class="small text-muted">@draft.CampaignCode · Saved @draft.UpdatedAtUtc.ToLocalTime().ToString("dd MMM yyyy, h:mm tt")</div></div><a class="btn btn-sm btn-outline-secondary" asp-action="Create" asp-route-draftId="@draft.Id">Continue draft</a></div>
        }
    </div>
}
@if (ViewData["Error"] is string error)
{
    <div class="alert alert-warning">@error</div>
}
<div class="panel">
    <div class="table-responsive">
        <table class="table mb-0 align-middle">
            <thead><tr><th>Campaign</th><th>Valid through</th><th>Active departments</th><th>Issued codes</th><th></th></tr></thead>
            <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="5" class="text-center text-muted py-5">No Customer PromoCode campaigns yet.</td></tr>
            }
            @foreach (var promo in Model)
            {
                <tr>
                    <td><strong>@promo.Name</strong> @if ((ViewData["DraftCampaignIds"] as HashSet<int>)?.Contains(promo.Id) == true) { <span class="badge bg-warning text-dark">Draft edits</span> }<div class="small text-muted">@promo.CampaignCode</div></td>
                    <td>@promo.Validity.ToString("dd MMM yyyy, h:mm tt")</td>
                    <td>@promo.ActiveDepartmentCount</td>
                    <td>@promo.IssuedCount</td>
                    <td class="text-end text-nowrap"><a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@promo.Id">Details</a> <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@promo.Id">Edit</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

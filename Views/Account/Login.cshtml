@model LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Sign in";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sign in · Al Qabayel Discount Center Admin</title>
    <link rel="icon" type="image/jpeg" href="~/images/al-qabayel-discount-center.jpg" />
    <link rel="stylesheet" href="~/css/login-redesign.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/myqabayel-theme.css" asp-append-version="true" />
</head>
<body class="login-page">
    <div class="login-frame">
        <header class="brand-header">
            <div class="brand-lockup">
                <span class="myqabayel-mark"><img src="~/images/al-qabayel-discount-center.jpg" alt="" /></span>
                <div>
                    <strong>MY QABAYEL</strong>
                    <span>DISCOUNT CENTER · ADMIN</span>
                </div>
            </div>
            <span class="secure-label"><span aria-hidden="true"></span> Secure workspace</span>
        </header>

        <main class="login-card">
            <section class="login-form-panel" aria-labelledby="login-title">
                <div class="login-intro">
                    <span class="eyebrow">ADMINISTRATOR ACCESS</span>
                    <h1 id="login-title">Welcome back.</h1>
                    <p>Sign in to manage your loyalty campaigns, offers, and member experience.</p>
                </div>

                <form asp-action="Login" asp-controller="Account" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <input asp-for="ReturnUrl" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="login-validation" role="alert"></div>

                    <div class="login-field">
                        <label asp-for="Email">Email address</label>
                        <div class="input-wrap">
                            <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m4 7 8 6 8-6" /></svg>
                            <input asp-for="Email" type="email" autocomplete="username" placeholder="name@company.com" autofocus />
                        </div>
                        <span asp-validation-for="Email" class="field-error"></span>
                    </div>

                    <div class="login-field">
                        <label asp-for="Password"></label>
                        <div class="input-wrap">
                            <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg>
                            <input asp-for="Password" type="password" autocomplete="current-password" placeholder="Enter your password" />
                            <button class="password-toggle" type="button" aria-label="Show password" data-password-toggle>Show</button>
                        </div>
                        <span asp-validation-for="Password" class="field-error"></span>
                    </div>

                    <label class="remember-row">
                        <input asp-for="RememberMe" />
                        <span>Keep me signed in</span>
                    </label>

                    <button class="login-submit" type="submit">
                        <span>Sign in to dashboard</span>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
                    </button>
                </form>

                <p class="login-help">Need access? Contact your system administrator.</p>
            </section>

            <aside class="brand-story" aria-label="Al Qabayel Discount Center loyalty administration">
                <div class="story-top"><span class="story-line"></span> THE LOYALTY EXPERIENCE</div>
                <div class="story-main">
                    <div class="story-logo"><img src="~/images/al-qabayel-discount-center.jpg" alt="Al Qabayel Discount Center" /></div>
                    <h2>Good offers.<br />Stronger connections.</h2>
                    <p>A focused place to shape campaigns, share offers, and keep your members engaged.</p>
                </div>
                <div class="story-footer">
                    <span>CAMPAIGNS</span><span>OFFERS</span><span>MEMBERS</span>
                </div>
            </aside>
        </main>

        <footer class="page-footer">
            <span>Al Qabayel Discount Center · Loyalty Administration</span>
            <span>For authorized team members</span>
        </footer>
    </div>
    <script>
        document.querySelector('[data-password-toggle]')?.addEventListener('click', function () {
            const input = document.getElementById('Password');
            const show = input.type === 'password';
            input.type = show ? 'text' : 'password';
            this.textContent = show ? 'Hide' : 'Show';
            this.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
        });
    </script>
</body>
</html>

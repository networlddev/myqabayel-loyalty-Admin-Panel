@model IReadOnlyList<Campaign>
<div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Campaign</th><th>Status</th><th>Schedule</th><th>App publication</th><th>Actions</th></tr></thead><tbody>
@if (Model.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-5">No campaigns are stored in the Admin database yet.</td></tr> }
@foreach (var item in Model) { <tr>
<td><div class="campaign-cell"><img src="@item.ImageUrl" alt=""/><div><b>@item.Title</b><small>@item.CampaignType · Admin ID #@item.Id · @item.Images.Count image(s)</small>@if(item.CampaignType == "Advertisement"){<small>Display: @item.DisplaySeconds sec · Skip: @(item.AllowSkip ? "Enabled" : "Disabled")</small>}</div></div></td>
<td><span class="status status-@item.Status.ToLowerInvariant()">@item.Status</span></td><td>@item.StartDateUtc.ToString("dd MMM yyyy")<small class="d-block text-muted">to @item.EndDateUtc.ToString("dd MMM yyyy")</small></td><td>@item.PublishStatus @if(item.ErpRecordId is not null){<small class="d-block text-muted">ERP ID #@item.ErpRecordId</small>}</td>
<td>@if(item.CampaignType == "Advertisement"){<form asp-action="UpdateAdvertisementPlayback" asp-route-id="@item.Id" method="post" class="d-flex align-items-center gap-1 mb-2"><input class="form-control form-control-sm" style="width:72px" type="number" name="displaySeconds" value="@item.DisplaySeconds" min="1" max="300"/><input type="hidden" name="allowSkip" value="false"/><label class="small text-nowrap"><input class="form-check-input" type="checkbox" name="allowSkip" value="true" checked="@(item.AllowSkip ? "checked" : null)"/> Skip</label><button class="btn btn-sm btn-outline-primary">Save</button></form>}<div class="d-flex flex-wrap gap-1"><a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.Id">View</a><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Edit</a><form asp-action="Publish" asp-route-id="@item.Id" method="post"><button class="btn btn-sm btn-success" title="Publish this campaign to the loyalty app">@(item.Status == "Draft" ? "Publish" : "Publish Again")</button></form><form asp-action="Archive" asp-route-id="@item.Id" method="post"><button class="btn btn-sm btn-outline-warning">Archive</button></form><a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">Delete</a></div></td>
</tr> }
</tbody></table></div>
